# ── User Identity ──
HD_USER_ID=your_name

# ── AWS ──
HD_AWS_REGION=eu-west-2
HD_DASHBOARD_AUTH_USER=your_username
HD_DASHBOARD_AUTH_PASS=CHANGE_ME

# ── iOS / Apple Developer ──
HD_BUNDLE_ID=com.yourcompany.healthdashboard
HD_DEVELOPMENT_TEAM=YOUR_APPLE_TEAM_ID
HD_ASC_KEY_ID=YOUR_ASC_KEY_ID

# ── API (auto-populated by setup.sh --post-deploy) ──
HD_API_BASE_URL=
